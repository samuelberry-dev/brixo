    {
      "id": 12,
      "class": "Script",
      "name": "Script",
      "parent": 0,
      "children": [],
      "props": {
        "Script": {
          "source": "-- A new coin at a random spot every 2 seconds, up to 25 at a time.\ncoins_folder = create(\"Folder\", find(\"Workspace\"))\ncoins_folder.name = \"Coins\"\n\nevery 2 seconds\n    if len(coins_folder.children) < 25 then\n        coin = clone(find(\"Coin Template\"))\n        coin.name = \"Coin\"\n        coin.position = {x = random(-50, 50), y = 3, z = random(-50, 50)}\n        coin.parent = coins_folder\n    end\nend",
          "enabled": true
        }
      }
    }
