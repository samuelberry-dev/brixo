    {
      "id": 4,
      "class": "Script",
      "name": "Script",
      "parent": 3,
      "children": [],
      "props": {
        "Script": {
          "source": "gone = false\n\non touched(other)\n    if other.class == \"player\" and not gone and other.coins != nil then\n        gone = true\n        other.coins += 1\n        for c in other.children do\n            if c.name == \"Coin Label\" then\n                c.text = \"Coins: \" + other.coins\n            end\n        end\n        play_sound(\"coin\", other)\n        destroy(self)\n    end\nend\n\nevery 0.03 seconds\n    self.rotation.y += 4\nend",
          "enabled": true
        }
      }
    },
    {
      "id": 10,
      "class": "Script",
      "name": "Script",
      "parent": 0,
      "children": [],
      "props": {
        "Script": {
          "source": "-- Coins: every player's coin count, and their label.\non player_joined(p)\n    p.coins = 0\n    label = create(\"TextLabel\", p)\n    label.name = \"Coin Label\"\n    label.text = \"Coins: 0\"\n    label.x = 0.02\n    label.y = 0.12\n    label.width = 0.14\n    label.height = 0.06\n    label.text_size = 24\n    label.background = true\n    label.background_color = {r = 30, g = 30, b = 30}\n    label.text_color = {r = 245, g = 205, b = 48}\nend",
          "enabled": true
        }
      }
    },
