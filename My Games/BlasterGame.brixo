    {
      "id": 7,
      "class": "Script",
      "name": "Script",
      "parent": 5,
      "children": [],
      "props": {
        "Script": {
          "source": "BASE_SPEED = 90\nSTART_SCALE = 0.1   -- keep in sync with start_scale in the Plasma Ball script\n\nready_at = 0\n\non activated(p)\n    if time() < ready_at then\n        return\n    end\n    ready_at = time() + 0.35\n\n    f = p.look\n    from = {x = p.position.x + f.x * 3, y = p.position.y + 1.5, z = p.position.z + f.z * 3}\n    t = p.mouse\n    dx = t.x - from.x\n    dy = t.y - from.y\n    dz = t.z - from.z\n    d = max(sqrt(dx * dx + dy * dy + dz * dz), 0.01)\n    ux = dx / d\n    uy = dy / d\n    uz = dz / d\n\n    ball = clone(find(\"Plasma Ball\"))\n    ball.name = \"Plasma\"\n    ball.owner = p.name            -- so its script knows who fired it\n    ball.position = from\n    ball.floating = true           -- no gravity: flies straight\n    ball.anchored = false\n\n    -- direction and base speed for the ball's script to read\n    ball.ux = ux\n    ball.uy = uy\n    ball.uz = uz\n    ball.base_speed = BASE_SPEED\n\n    local_speed = BASE_SPEED * START_SCALE\n    ball.velocity = {x = ux * local_speed, y = uy * local_speed, z = uz * local_speed}\n    ball.parent = find(\"Workspace\")\n    play_sound_at(\"twang\", p)\nend",
          "enabled": true
        }
      }
    },
