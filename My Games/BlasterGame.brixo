      "name": "Script",
      "parent": 9,
      "children": [],
      "props": {
        "Script": {
          "source": "on touched(other)\n    if other.class == \"player\" then\n        for t in other.children do\n            if t.name == \"Blaster\" then\n                return      -- they already have one\n            end\n        end\n        copy = clone(find(\"Blaster\"))\n        copy.parent = other\n        play_sound(\"buy\", other)\n    end\nend",
          "enabled": true
        }
      }
