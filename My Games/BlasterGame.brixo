    {
      "id": 4,
      "class": "Script",
      "name": "Script",
      "parent": 3,
      "children": [],
      "props": {
        "Script": {
          "source": "-- The template in Storage waits to be copied: don't run there.\nif self.parent.name == \"Storage\" then\n    return\nend\n\ngone = false\nfn pop()\n    if not gone then\n        gone = true\n        destroy(self)\n    end\nend\n\non touched(other)\n    if gone then\n        return\n    end\n    -- Brushing the shooter's own gun on the way out doesn't count.\n    if other.parent != nil and other.parent.class == \"tool\" then\n        return\n    end\n    if other.class == \"player\" then\n        if other.name == self.owner then\n            return\n        end\n        shooter = find(self.owner)\n        if shooter != nil and other.health > 0 and (shooter.team == nil or other.team != shooter.team) then\n            other.health -= 20\n            other.last_hit_by = self.owner\n            play_sound_at(\"hit\", other)\n        end\n    end\n    pop()\nend\n\n-- Acceleration tuning\nstart_scale = 0.1   -- speed at launch, as a multiple of the gun's base speed\nend_scale = 4       -- speed at the end of its life, same units\nlifetime = 3\nstep = 0.05\n\n-- Fired by something that didn't set a direction: old behavior, no acceleration.\nif self.ux == nil then\n    print(\"plasma ball has no direction, flying at launch speed\")\n    wait(lifetime)\n    pop()\n    return\nend\n\nstarted = time()\nwhile not gone do\n    t = time() - started\n    if t >= lifetime then\n        break\n    end\n    scale = start_scale + (end_scale - start_scale) * (t / lifetime)\n    speed = self.base_speed * scale\n    self.velocity = {x = self.ux * speed, y = self.uy * speed, z = self.uz * speed}\n    wait(step)\nend\n\npop()   -- gone after 3 seconds if it didn't hit anything",
          "enabled": true
        }
      }
    },
