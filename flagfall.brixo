    {
      "id": 647,
      "class": "Script",
      "name": "Use",
      "parent": 642,
      "children": [],
      "props": {
        "Script": {
          "source": "\nfn ready(tool, seconds)\n    if tool.ready_at != nil and time() < tool.ready_at then\n        return false\n    end\n    tool.ready_at = time() + seconds\n    return true\nend\n\nfn enemy(p, other)\n    if other.class != \"player\" or other == p or other.health <= 0 then\n        return false\n    end\n    return p.team == nil or other.team != p.team\nend\n\nfn hurt(p, other, amount)\n    other.health -= amount\n    other.last_hit_by = p.name\nend\n-- The fastest, weakest gear: 2 damage, a 0.5s cooldown. Not for killing —\n-- for area denial and marking a target (a splat, and a burst of your\n-- colour that fades), especially useful for covering ground without\n-- risking a real fight.\non activated(p)\n    if not ready(self, 0.5) then\n        return\n    end\n    f = p.look\n    b = clone(find(\"Paintball Template\"))\n    b.name = \"Paintball\"\n    b.owner = p.name\n    b.color = p.shirt_color\n    -- (From chest height, so it meets people square on.)\n    b.position = {x = p.position.x + f.x * 2.5, y = p.position.y + 0.8, z = p.position.z + f.z * 2.5}\n    b.anchored = false\n    b.parent = find(\"Projectiles\")\n    b.velocity = {x = f.x * 130, y = 1, z = f.z * 130}\n    play_sound(\"click\")\nend\n",
          "enabled": true
        }
      }
    },
    {
      "id": 648,
      "class": "Part",
      "name": "Paintball Template",
      "parent": 606,
      "children": [
        649
      ],
      "props": {
        "Part": {
          "position": {
            "x": 32.0,
            "y": -300.0,
            "z": 0.0
          },
          "size": {
            "x": 0.4,
            "y": 0.4,
            "z": 0.4
          },
          "rotation": {
            "x": 0.0,
            "y": 0.0,
            "z": 0.0
          },
          "color": {
            "r": 255,
            "g": 255,
            "b": 255
          },
          "anchored": true,
          "can_collide": true,
          "shape": "Ball",
          "material": "Plastic",
          "transparency": 0.0,
          "velocity": {
            "x": 0.0,
