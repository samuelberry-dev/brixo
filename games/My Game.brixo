      "id": 13,
      "class": "Script",
      "name": "Collect",
      "parent": 12,
      "children": [],
      "props": {
        "Script": {
          "source": "-- Walk into me! Can collide is off, so you pass through.\non touched(other)\n    if other.class == \"player\" then\n        print(other.name + \" grabbed a coin!\")\n        other.face = \"happy\"\n        destroy(self)\n    end\nend\n\nevery 0.03 seconds\n    self.rotation.y += 5\nend\n",
          "enabled": true
        }
      }
    },
