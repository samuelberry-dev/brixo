      "name": "Greeter",
      "parent": 0,
      "children": [],
      "props": {
        "Script": {
          "source": "-- Runs on the server: everyone hears about joins and leaves.\non player_joined(p)\n    print(\"Welcome, \" + p.name + \"! \" + len(players()) + \" playing\")\nend\n\non player_left(p)\n    print(p.name + \" left\")\nend\n",
          "enabled": true
        }
      }
