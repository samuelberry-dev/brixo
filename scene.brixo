    {
      "id": 261,
      "class": "Script",
      "name": "Script",
      "parent": 260,
      "children": [],
      "props": {
        "Script": {
          "source": "direction = 1\n\nevery 0.05 seconds\n    self.position.x += direction * 0.1\n\n    if self.position.x >= 57.5 then\n        direction = -1\n    end\n\n    if self.position.x <= 24.5 then\n        direction = 1\n    end\nend",
          "enabled": true
        }
      }
    },
