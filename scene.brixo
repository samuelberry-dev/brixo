      "name": "PlatformMotion",
      "parent": 308,
      "children": [],
      "props": {
        "Script": {
          "source": "direction = 1\n\nevery 0.05 seconds\n    self.position.z += direction * 0.12\n    if self.position.z >= 8 then\n        direction = -1\n    end\n    if self.position.z <= -8 then\n        direction = 1\n    end\nend",
          "enabled": true
        }
      }
