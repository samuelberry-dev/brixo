# Brixo's live settings. The deploy script copies this to /etc/brixo/brixo.env
# the first time only; after that, edit /etc/brixo/brixo.env on the server and
# run: systemctl restart brixo-web
BRIXO_WEB_DB=/var/lib/brixo/brixo-web.sqlite
PORT=7420
BRIXO_WEB_BIND=127.0.0.1
BRIXO_PUBLIC_HOST=playbrixo.com
# 20 ports = at most 20 games running at once (right for a small server).
BRIXO_GAME_PORTS=7500-7519
BRIXO_SECURE_COOKIES=1
BRIXO_TRUST_PROXY=1
BRIXO_INVITE_ONLY=1
